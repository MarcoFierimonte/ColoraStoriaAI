# Server port (required: 3000 in preview/runtime)
PORT=3000

# Active AI provider: "gemini" (default) | "openai"
AI_PROVIDER=gemini

# Optional prompt version override (defaults to prompts/config.json -> "latest")
PROMPT_VERSION=

# Google Gemini API key (store in Secret Manager in production, never in plain env)
GEMINI_API_KEY=

# Free Gemini model by default: "gemini-4-hydrogen" (or "gemini-3.1-flash-lite")
# Optional paid raster image models: "gemini-3.1-flash-lite-image" | "gemini-nano-banana-2.1"
GEMINI_MODEL=gemini-4-hydrogen

# Optional OpenAI API key & model for provider switching
OPENAI_API_KEY=
OPENAI_MODEL=gpt-image-1

# Optional comma-separated verified Google emails allowed to view Admin telemetry
# Leave empty if relying solely on the Firebase Auth custom claim `{ admin: true }`
ADMIN_EMAILS=

# Anti-bot protection (Cloudflare Turnstile or Firebase App Check)
# Required on public production deployments to protect AI quotas
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=
APP_CHECK_ENABLED=false
BOT_PROTECTION_REQUIRED=false
