# Required: Google Gemini API key (store in Secret Manager / AI Studio Secrets, never commit real values)
GEMINI_API_KEY=

# Optional variables (already have safe defaults in backend/src/modules/config/envConfig.ts):
# PORT=3000
# AI_PROVIDER=gemini
# GEMINI_MODEL=gemini-nano-banana-2.1
# PROMPT_VERSION=
# ADMIN_EMAILS=
# TURNSTILE_SECRET_KEY=
# VITE_TURNSTILE_SITE_KEY=
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-image-1
# APP_CHECK_ENABLED=false
# BOT_PROTECTION_REQUIRED=false
# BETA_INVITE_REQUIRED=false
# BETA_SESSION_SECRET=
#
# Optional: Admin Prompt Lab free-tier email notifications & batch polling
# EMAIL_PROVIDER=resend        # resend (3,000/mo free) | brevo (300/day free) | none
# RESEND_API_KEY=
# BREVO_API_KEY=
# EMAIL_FROM=ColoraStoria Prompt Lab <onboarding@resend.dev>
# APP_BASE_URL=https://your-app.run.app
# PROMPT_EVAL_CRON_SECRET=     # Optional (>=16 chars) for free-tier Cloud Scheduler POST /api/admin/prompt-eval/poll-pending
# PROMPT_EVAL_STORE=firestore  # firestore (free tier) | memory (local dev without GCP creds)
