# Server port (required: 3000 in preview/runtime)
PORT=3000

# Active AI provider: "gemini" (default) | "openai"
AI_PROVIDER=gemini

# Optional prompt version override (defaults to prompts/config.json -> "latest")
PROMPT_VERSION=

# Google Gemini API key (server-side only)
GEMINI_API_KEY=

# Free Gemini model by default: "gemini-4-hydrogen" (or "gemini-3.1-flash-lite")
# Optional paid raster image models: "gemini-3.1-flash-lite-image" | "gemini-nano-banana-2.1"
GEMINI_MODEL=gemini-4-hydrogen

# Optional OpenAI API key & model for provider switching
OPENAI_API_KEY=
OPENAI_MODEL=gpt-image-1
