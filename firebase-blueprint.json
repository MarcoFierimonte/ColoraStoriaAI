{
  "entities": {
    "AdminUser": {
      "title": "AdminUser",
      "description": "Authorized administrator record",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified administrator email",
          "minLength": 3,
          "maxLength": 254
        },
        "role": {
          "type": "string",
          "enum": ["admin"],
          "description": "Assigned privilege role"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of creation"
        }
      },
      "required": ["uid", "email", "role", "createdAt"]
    },
    "GenerationLog": {
      "title": "GenerationLog",
      "description": "Per-generation token usage and cost record for admin telemetry",
      "type": "object",
      "properties": {
        "adminUid": {
          "type": "string",
          "description": "Firebase UID of the admin who triggered the test generation",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "source": {
          "type": "string",
          "enum": ["creator", "prompt_lab"],
          "description": "Origin of the test generation (single creator dialog vs admin prompt lab)"
        },
        "executionMode": {
          "type": "string",
          "enum": ["standard", "batch"],
          "description": "API execution mode used"
        },
        "batchDiscountApplied": {
          "type": "boolean",
          "description": "Whether -50% Batch API discount applied"
        },
        "runId": {
          "type": "string",
          "maxLength": 128
        },
        "runTitle": {
          "type": "string",
          "maxLength": 120
        },
        "inputName": {
          "type": "string",
          "maxLength": 120
        },
        "provider": {
          "type": "string",
          "enum": ["gemini", "openai"],
          "description": "AI provider used"
        },
        "model": {
          "type": "string",
          "description": "Model identifier",
          "minLength": 1,
          "maxLength": 80
        },
        "promptVersion": {
          "type": "string",
          "description": "Version tag from prompts/config.json or custom",
          "minLength": 2,
          "maxLength": 20,
          "pattern": "^(v[0-9]+|custom)$"
        },
        "themeId": {
          "type": "string",
          "enum": ["fedele", "pirati", "unicorni", "draghi", "spazio", "dinosauri", "principessa"],
          "description": "Selected coloring book theme"
        },
        "outputFormat": {
          "type": "string",
          "enum": ["svg", "raster", "text"],
          "description": "Output asset format"
        },
        "inputTokens": {
          "type": "integer",
          "description": "Total input tokens"
        },
        "cachedInputTokens": {
          "type": "integer",
          "description": "Cached input tokens"
        },
        "textOutputTokens": {
          "type": "integer",
          "description": "Text and reasoning output tokens"
        },
        "imageOutputTokens": {
          "type": "integer",
          "description": "Image output tokens"
        },
        "estimatedCostUsd": {
          "type": "number",
          "description": "Estimated single-image cost in USD"
        },
        "latencyMs": {
          "type": "integer",
          "description": "End-to-end provider call duration in milliseconds"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of generation"
        }
      },
      "required": [
        "adminUid",
        "provider",
        "model",
        "promptVersion",
        "themeId",
        "outputFormat",
        "inputTokens",
        "cachedInputTokens",
        "textOutputTokens",
        "imageOutputTokens",
        "estimatedCostUsd",
        "latencyMs",
        "createdAt"
      ]
    },
    "BetaInvite": {
      "title": "BetaInvite",
      "description": "Server-managed personal beta invite code with generation quota and optional expiration",
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "description": "Normalized uppercase invite code",
          "minLength": 4,
          "maxLength": 32
        },
        "label": {
          "type": "string",
          "description": "Tester display label",
          "minLength": 1,
          "maxLength": 60
        },
        "maxGenerations": {
          "type": "integer",
          "description": "Maximum allowed generations"
        },
        "usedGenerations": {
          "type": "integer",
          "description": "Atomic count of consumed generations"
        },
        "expiresAtMs": {
          "type": ["integer", "null"],
          "description": "Optional expiration epoch milliseconds"
        },
        "active": {
          "type": "boolean",
          "description": "Whether the invite is enabled"
        },
        "createdAtMs": {
          "type": "integer",
          "description": "Creation epoch milliseconds"
        },
        "createdByEmail": {
          "type": "string",
          "description": "Creator identifier"
        },
        "lastUsedAtMs": {
          "type": ["integer", "null"],
          "description": "Last generation epoch milliseconds"
        }
      },
      "required": [
        "code",
        "label",
        "maxGenerations",
        "usedGenerations",
        "active",
        "createdAtMs",
        "createdByEmail"
      ]
    },
    "PromptEvalRun": {
      "title": "PromptEvalRun",
      "description": "Server-managed admin prompt evaluation run supporting standard and batch APIs, email delivery status, and run-level notes/ratings",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "createdByUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdByEmail": { "type": "string", "minLength": 1, "maxLength": 254 },
        "modality": { "type": "string", "enum": ["image", "text"] },
        "executionMode": { "type": "string", "enum": ["standard", "batch"] },
        "providerId": { "type": "string", "enum": ["gemini", "openai"] },
        "model": { "type": "string", "minLength": 1, "maxLength": 80 },
        "promptSource": { "type": "string", "enum": ["catalog", "custom"] },
        "promptLabel": { "type": "string" },
        "promptText": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["queued", "running", "completed", "partial", "failed", "cancelled"]
        },
        "totalItems": { "type": "integer" },
        "completedItems": { "type": "integer" },
        "failedItems": { "type": "integer" },
        "totalEstimatedCostUsd": { "type": "number" },
        "externalBatchJobId": { "type": ["string", "null"] },
        "notifyEmail": { "type": ["string", "null"] },
        "notificationStatus": {
          "type": "string",
          "enum": ["not_requested", "pending", "sent", "failed"]
        },
        "createdAtMs": { "type": "integer" },
        "updatedAtMs": { "type": "integer" }
      },
      "required": [
        "id",
        "title",
        "createdByUid",
        "createdByEmail",
        "modality",
        "executionMode",
        "providerId",
        "model",
        "promptSource",
        "promptText",
        "status",
        "totalItems",
        "completedItems",
        "failedItems",
        "createdAtMs",
        "updatedAtMs"
      ]
    },
    "PromptEvalItem": {
      "title": "PromptEvalItem",
      "description": "Individual image or text input result, output media, usage breakdown, and admin rating/notes inside a PromptEvalRun",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "index": { "type": "integer" },
        "inputName": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["pending", "running", "completed", "failed"]
        },
        "outputFormat": { "type": "string", "enum": ["raster", "svg", "text"] },
        "outputImageDataUrl": { "type": "string" },
        "outputText": { "type": "string" },
        "errorMessage": { "type": "string" }
      },
      "required": ["id", "index", "inputName", "status"]
    },
    "PromptEvalDataset": {
      "title": "PromptEvalDataset",
      "description": "Server-managed reusable admin evaluation image dataset created from the app",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "slug": { "type": "string", "minLength": 1, "maxLength": 64 },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "description": { "type": "string", "maxLength": 240 },
        "source": { "type": "string", "enum": ["app"] },
        "readOnly": { "type": "boolean" },
        "itemCount": { "type": "integer" },
        "previewThumbnails": {
          "type": "array",
          "items": { "type": "string" }
        },
        "createdAtMs": { "type": "integer" },
        "updatedAtMs": { "type": "integer" },
        "createdByEmail": { "type": "string" }
      },
      "required": [
        "id",
        "slug",
        "name",
        "source",
        "readOnly",
        "itemCount",
        "createdAtMs",
        "updatedAtMs"
      ]
    },
    "PromptEvalDatasetItem": {
      "title": "PromptEvalDatasetItem",
      "description": "Normalized input image stored inside a server-managed PromptEvalDataset",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "index": { "type": "integer" },
        "name": { "type": "string" },
        "mimeType": { "type": "string" },
        "sizeBytes": { "type": "integer" },
        "width": { "type": "integer" },
        "height": { "type": "integer" },
        "thumbnailDataUrl": { "type": "string" },
        "imageDataUrl": { "type": "string" }
      },
      "required": ["id", "index", "name", "mimeType", "sizeBytes", "imageDataUrl"]
    }
  },
  "firestore": {
    "/admins/{adminId}": {
      "schema": {
        "$ref": "#/entities/AdminUser"
      },
      "description": "Verified administrator role documents"
    },
    "/generation_logs/{logId}": {
      "schema": {
        "$ref": "#/entities/GenerationLog"
      },
      "description": "Admin-only AI generation usage and cost logs"
    },
    "/beta_invites/{inviteCode}": {
      "schema": {
        "$ref": "#/entities/BetaInvite"
      },
      "description": "Server-only invite codes and generation quotas managed by backend Cloud Run service account"
    },
    "/prompt_eval_runs/{runId}": {
      "schema": {
        "$ref": "#/entities/PromptEvalRun"
      },
      "description": "Server-only admin prompt evaluation runs managed via backend API"
    },
    "/prompt_eval_runs/{runId}/items/{itemId}": {
      "schema": {
        "$ref": "#/entities/PromptEvalItem"
      },
      "description": "Server-only per-item evaluation outputs, thumbnails, ratings, and notes"
    },
    "/prompt_eval_datasets/{datasetId}": {
      "schema": {
        "$ref": "#/entities/PromptEvalDataset"
      },
      "description": "Server-only reusable admin evaluation datasets created from the app"
    },
    "/prompt_eval_datasets/{datasetId}/items/{itemId}": {
      "schema": {
        "$ref": "#/entities/PromptEvalDatasetItem"
      },
      "description": "Server-only normalized dataset images and thumbnails"
    }
  }
}
