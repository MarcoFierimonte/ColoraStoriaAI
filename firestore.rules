rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny all reads/writes unless explicitly allowed
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Requires verified email AND server-assigned Firebase custom claim `{ admin: true }`
    function isAdmin() {
      return isSignedIn() &&
        request.auth.token.email_verified == true &&
        request.auth.token.admin == true;
    }

    function isValidGenerationLog(data) {
      return data.keys().hasAll([
          'adminUid',
          'provider',
          'model',
          'promptVersion',
          'themeId',
          'outputFormat',
          'inputTokens',
          'cachedInputTokens',
          'textOutputTokens',
          'imageOutputTokens',
          'estimatedCostUsd',
          'latencyMs',
          'createdAt'
        ]) &&
        data.keys().hasOnly([
          'adminUid',
          'provider',
          'model',
          'promptVersion',
          'themeId',
          'outputFormat',
          'inputTokens',
          'cachedInputTokens',
          'textOutputTokens',
          'imageOutputTokens',
          'estimatedCostUsd',
          'latencyMs',
          'createdAt'
        ]) &&
        data.adminUid is string &&
        data.adminUid == request.auth.uid &&
        data.adminUid.size() >= 1 && data.adminUid.size() <= 128 &&
        data.adminUid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.provider in ['gemini', 'openai'] &&
        data.model is string && data.model.size() >= 1 && data.model.size() <= 80 &&
        data.promptVersion is string && data.promptVersion.size() >= 2 && data.promptVersion.size() <= 20 &&
        data.promptVersion.matches('^v[0-9]+$') &&
        data.themeId in ['fedele', 'pirati', 'unicorni', 'draghi', 'spazio', 'dinosauri', 'principessa'] &&
        data.outputFormat in ['svg', 'raster'] &&
        data.inputTokens is int && data.inputTokens >= 0 && data.inputTokens <= 1000000 &&
        data.cachedInputTokens is int && data.cachedInputTokens >= 0 && data.cachedInputTokens <= 1000000 &&
        data.textOutputTokens is int && data.textOutputTokens >= 0 && data.textOutputTokens <= 1000000 &&
        data.imageOutputTokens is int && data.imageOutputTokens >= 0 && data.imageOutputTokens <= 1000000 &&
        (data.estimatedCostUsd is float || data.estimatedCostUsd is int) &&
        data.estimatedCostUsd >= 0 && data.estimatedCostUsd <= 100 &&
        data.latencyMs is int && data.latencyMs >= 0 && data.latencyMs <= 600000 &&
        data.createdAt == request.time;
    }

    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && (request.auth.uid == adminId || isAdmin());
      allow list: if false;
      allow create, update, delete: if false;
    }

    match /generation_logs/{logId} {
      allow get: if isValidId(logId) && isAdmin();
      allow list: if isAdmin() && resource.data.adminUid == request.auth.uid;
      allow create: if isValidId(logId) && isValidGenerationLog(incoming()) && isAdmin();
      allow update: if false;
      allow delete: if isValidId(logId) && isAdmin();
    }

    // Beta invite codes & quotas are strictly managed server-side via firebase-admin
    match /beta_invites/{inviteCode} {
      allow read, write: if false;
    }

    // Admin prompt evaluation runs & per-item outputs/notes are strictly managed server-side via firebase-admin
    match /prompt_eval_runs/{runId} {
      allow read, write: if false;

      match /items/{itemId} {
        allow read, write: if false;
      }
    }
  }
}
