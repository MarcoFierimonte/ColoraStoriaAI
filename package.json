{
  "name": "material-flask",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "[ -d node_modules/.bin ] || bun install || npm install",
    "dev": "NODE_ENV=development tsx server.ts",
    "start": "NODE_ENV=production node server.ts",
    "prebuild": "[ -d node_modules/.bin ] || bun install || npm install",
    "build": "vite build --config web-app/vite.config.ts",
    "prelint": "[ -d node_modules/.bin ] || bun install || npm install",
    "lint": "tsc --noEmit && eslint .",
    "prompts:sync": "node prompts/sync-manual.mjs"
  },
  "dependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@google/genai": "^3.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.15.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "firebase": "^13.3.0",
    "firebase-admin": "^14.5.1",
    "gsap": "^3.12.7",
    "helmet": "^8.3.0",
    "lenis": "^1.1.20",
    "lucide-react": "^1.73.0",
    "multer": "^2.5.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
